# Dhan API credentials
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Renew active Dhan Web-generated tokens only when within 13 hours of expiry.
# This rotates the token and updates this .env file; expired tokens cannot be renewed.
# Enable only if this scanner is the sole user of the token.
AUTO_RENEW_DHAN_TOKEN=false

# Optional Telegram channel or chat alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Set true only when you intend to submit real orders.
# Also pass --enable-live-orders when starting the scanner.
ENABLE_LIVE_ORDERS=false
